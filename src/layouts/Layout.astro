---
import { url } from '../lib/url';

interface Props {
  title?: string;
  description?: string;
}
const { title = 'Hamburguesas Javier Ismel', description = 'Hamburguesas artesanales Javier Ismel' } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={url('favicon.svg')} />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Anton&family=Inter:wght@400;500;700&display=swap" rel="stylesheet" />
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  html { scroll-behavior: smooth; }
  :root {
    --fondo: #0f110c;
    --texto: #f2f2ea;
    --suave: #9a9c90;
    --acento: #d2ff00;
    --display: 'Anton', 'Impact', sans-serif;
    color-scheme: dark;
    font-family: 'Inter', system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
  }
  * { box-sizing: border-box; }
  body { margin: 0; background: var(--fondo); color: var(--texto); line-height: 1.6; }
  img { max-width: 100%; display: block; }
  a { color: var(--acento); }
</style>
